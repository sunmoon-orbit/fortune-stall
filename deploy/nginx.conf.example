# 此文件通常放到 /etc/nginx/sites-available/fortune-stall，
# 再链接到 sites-enabled。部署前把 fortune.example.com 换成真实子域名。
limit_req_zone $binary_remote_addr zone=fortune_api:10m rate=30r/m;

server {
    listen 80;
    listen [::]:80;
    server_name fortune.example.com;
    server_tokens off;
    client_max_body_size 64k;

    location /api/ {
        limit_req zone=fortune_api burst=12 nodelay;
        proxy_pass http://127.0.0.1:3900;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location = /healthz {
        access_log off;
        proxy_pass http://127.0.0.1:3900;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:3900;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

